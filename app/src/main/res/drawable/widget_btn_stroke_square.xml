<?xml version="1.0" encoding="utf-8"?>
<!-- Widget layer; coloured at runtime with setColorFilter (see WidgetTheme).
     The transparent solid matters: a GradientDrawable with no fill colour gets filled
     solid when a colour filter is applied, covering everything under the outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
    <corners android:radius="6dp" />
</shape>
